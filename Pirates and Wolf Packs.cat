  <sharedProfiles>
    <profile name="Defensive Corridors" id="e66e-8b85-1f52-1dbf" hidden="false" typeId="5a49-6569-78e9-a35c" typeName="Special Rule">
      <characteristics>
        <characteristic name="Effects" typeId="fe13-6bab-c5cb-4f1d">+1 to its dice roll when defending against boarding action.</characteristic>
      </characteristics>
    </profile>
    <profile name="Prow Nova Cannon" id="5ad4-a05b-61f4-7b44" hidden="false" typeId="41726d616d656e7423232344415441232323" typeName="Armament">
      <characteristics>
        <characteristic name="Range/Speed" typeId="52616e67652f537065656423232344415441232323">30-150cm</characteristic>
        <characteristic name="Firepower/Str" typeId="46697265706f7765722f53747223232344415441232323">1</characteristic>
        <characteristic name="Fire Arc" typeId="4.669726520417263e+35">Front</characteristic>
      </characteristics>
    </profile>
    <profile name="Sensorial Prow" id="4906-7916-5545-859e" hidden="false" typeId="5a49-6569-78e9-a35c" typeName="Special Rule">
      <characteristics>
        <characteristic name="Effects" typeId="fe13-6bab-c5cb-4f1d">+1 Leadership</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
  <sharedRules>
    <rule name="Augmented Weapon Relays admec" id="9e61-c578-e18f-0977" hidden="false">
      <description>Weapon batteries shift left on the gunnery table before all other modifiers are applied. Lance hits count double on rolls of a 6.</description>
    </rule>
    <rule name="Emergency Energy Reserves admec" id="ec0c-b540-1280-ca77" hidden="false">
      <description>When crippled, the ship only reduces turrets, shielding and weapons by 25% rather than 50%. The vessel still counts as crippled in every other respect.</description>
    </rule>
    <rule name="Fleet Defense Turrets admec" id="46f8-8469-7037-9e1b" hidden="false">
      <description>Up to two turrets on the ship are exchanged for fleet defense turrets capable of protecting itself or any one other vessel within 15cm each ordnance phase, adding +2 to the turret strength of the ship it is defending (this does not alter bomber attack rolls when used to defend another vessel). These otherwise work exactly as normal turrets do in all other respects.</description>
    </rule>
    <rule name="Gyro-stabilized Targeting Matrix admec" id="d7cc-7fbe-1fd2-e1d5" hidden="false">
      <description>Ship weapons are reduced to 75% instead of 50% when on All Ahead Full, Come To New Heading or Burn Retros special orders. Nova Cannon still cannot fire.</description>
    </rule>
    <rule name="Improved Thrusters" id="ef41-096b-ef51-90be" hidden="false">
      <description>Moves +1D6 on All Ahead Full special orders.</description>
    </rule>
    <rule name="Repulsor Shielding admec" id="9a00-c0f7-8049-8308" hidden="false">
      <description>Ignore all negative effects of having a blast marker or gas clouds in contact with the ship’s base as it applies to leadership, movement and repairing critical damage. This effect goes away if the ship suffers “Shields Collapsed” critical damage.</description>
    </rule>
  </sharedRules>
