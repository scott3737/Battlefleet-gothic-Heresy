                      <rules>
                        <rule name="Extra Shield" id="06ea-59b8-249c-ceee" hidden="false" page="23" publicationId="5766-7751-d146-0800">
                          <description>The Chaos Repulsive Grand Cruiser can be modelled on a large base. If so mounted, it may have a third shield for +15pts. It must be modelled on a large base to have this this refit available for the cost indicated. This is not a normal refit and can be used in one-off games or in addition to any other refits earned normally in the course of a campaign.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
