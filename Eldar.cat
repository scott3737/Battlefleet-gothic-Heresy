            <characteristic name="Fire Arc" typeId="4.669726520417263e+35">Front</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Eldar Transport" id="8897-9682-7793-0053" hidden="false">
          <description>Though Eldar transports are like their other starships in that they are crewed by those who have elected the Path of the Mariner, these ships are generally led by Craftmasters that are less experienced than those who pilot true warships and thus suffer -1 modifier against the Eldar leadership table. Eldar transports are reserved for scenarios that require transports, for which they have the value of a full transport or two assault points.</description>
        </rule>
      </rules>
    </selectionEntry>
