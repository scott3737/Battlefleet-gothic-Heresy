          </conditionGroups>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Farseers" id="bcbe-25a0-364d-3e29" hidden="false">
          <description>You may include up to three Farseers in your fleet, each of whom must be assigned to a capital ship (including the flagship if desired) and gives the vessel a re-roll which may be used on itself, another capital ship in the same squadron or an escort squadron within 15cm.</description>
        </rule>
      </rules>
