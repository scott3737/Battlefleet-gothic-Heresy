      <profiles>
        <profile name="Haven Space Station Profile" id="17ed-4a34-93e2-2cfc" hidden="false" typeId="556e697423232344415441232323" typeName="Unit">
          <characteristics>
            <characteristic name="Type" typeId="5.479706523232345e+27">Defense</characteristic>
            <characteristic name="Hits" typeId="4.869747323232344e+27">8</characteristic>
