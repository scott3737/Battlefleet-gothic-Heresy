    <selectionEntry name="Prince Yriel, Bearer Of The Flame, Autarch Of Iyandea" id="b982-0231-722f-4fa6" collective="false" hidden="true" import="true" page="137" publicationId="5766-7751-d146-0800" type="upgrade">
      <categoryLinks>
        <categoryLink name="Fleet Commander" id="3c31-844c-763d-6c1e" hidden="false" primary="true" targetId="466c65657420436f6d6d616e6465727323232344415441232323"/>
