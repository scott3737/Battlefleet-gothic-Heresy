      </modifiers>
      <rules>
        <rule name="Eldar Hero" id="a3a8-59f3-5393-11a1" hidden="false" page="137" publicationId="5766-7751-d146-0800">
          <description>Your fleet may be led by an Eldar Hero, in place of its normal fleet commander. Only a fleet led by an Eldar Hero may take reserves from the Corsair Eldar fleet list. Contrariwise, only when a Corsair Eldar fleet is led by an Eldar Hero in place of its fleet commander may it take reserves form the Craftworld Eldar fleet list.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
