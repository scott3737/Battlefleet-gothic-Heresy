              </conditions>
            </conditionGroup>
          </conditionGroups>
        </modifier>
        <modifier field="4bad-36a3-6fba-1d24" type="decrement" value="1">
          <conditions>
            <condition childId="any" field="points" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="force" shared="true" type="lessThan" value="1000"/>
          </conditions>
