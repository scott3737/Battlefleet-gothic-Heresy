      <profiles>
        <profile name="Siren&apos;s Summon" id="97e8-2f3c-5270-805a" hidden="false" page="123" publicationId="5766-7751-d146-0800" typeId="5a49-6569-78e9-a35c" typeName="Special Rule">
          <characteristics>
            <characteristic name="Effects" typeId="fe13-6bab-c5cb-4f1d">Up to two capital ships with the Mark of Slaanesh (including the flagship) may take the Siren‟s Summon. While within 15cm of a vessel with Siren‟s Summon, enemy ships cannot take special orders or make leadership checks of any type, including Brace For Impact.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
