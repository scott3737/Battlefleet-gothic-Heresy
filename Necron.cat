        <selectionEntry name="Sepulchre" id="dcf4428b-cd08-429a-966f-f94ebaef77a5" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <categoryLinks>
            <categoryLink name="Battleship" id="dcf4428b-cd08-429a-966f-f94ebaef77a5-4361706974616c20536869707323232344415441232323" hidden="false" primary="true" targetId="4361706974616c20536869707323232344415441232323"/>
