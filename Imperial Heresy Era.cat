        <rule name="Terminator Teleport" id="7ec4-8120-be09-ba95" hidden="false">
          <description>Terminator Teleport Assault (roll 2D6 when conducting H&amp;R teleport attacks and select which one you wish to count).
(This is the Marshal/Master of the fleet, you can&apos;t have 2!).</description>
        </rule>
        <rule name="Sword Brethren" id="0817-0bf1-b535-e51d" hidden="false">
