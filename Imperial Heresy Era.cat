          </characteristics>
        </profile>
        <profile name="Hellfire Starboard Weapons Battery" id="a0cb-8534-1aa3-61ce" hidden="false" typeId="41726d616d656e7423232344415441232323" typeName="Armament">
          <characteristics>
            <characteristic name="Range/Speed" typeId="52616e67652f537065656423232344415441232323">45cm</characteristic>
            <characteristic name="Firepower/Str" typeId="46697265706f7765722f53747223232344415441232323">8</characteristic>
            <characteristic name="Fire Arc" typeId="4.669726520417263e+35">Right</characteristic>
          </characteristics>
        </profile>
        <profile name="Hellfire Dorsal Lance Battery" id="bd65-f2ee-66a2-13cc" hidden="false" typeId="41726d616d656e7423232344415441232323" typeName="Armament">
          <characteristics>
            <characteristic name="Range/Speed" typeId="52616e67652f537065656423232344415441232323">60cm</characteristic>
            <characteristic name="Firepower/Str" typeId="46697265706f7765722f53747223232344415441232323">1</characteristic>
            <characteristic name="Fire Arc" typeId="4.669726520417263e+35">Left/Front/Right</characteristic>
          </characteristics>
        </profile>
        <profile name="Hellfire Prow Weapons Battery" id="45e3-6fcf-cafb-9eaa" hidden="false" typeId="41726d616d656e7423232344415441232323" typeName="Armament">
          <characteristics>
            <characteristic name="Range/Speed" typeId="52616e67652f537065656423232344415441232323">30cm</characteristic>
            <characteristic name="Firepower/Str" typeId="46697265706f7765722f53747223232344415441232323">6</characteristic>
            <characteristic name="Fire Arc" typeId="4.669726520417263e+35">Left/Front/Right</characteristic>
          </characteristics>
        </profile>
        <profile name="Hellfire Port Lance Battery" id="93dc-30c6-d6cb-bea6" hidden="false" typeId="41726d616d656e7423232344415441232323" typeName="Armament">
          <characteristics>
            <characteristic name="Range/Speed" typeId="52616e67652f537065656423232344415441232323">45m</characteristic>
            <characteristic name="Firepower/Str" typeId="46697265706f7765722f53747223232344415441232323">2</characteristic>
            <characteristic name="Fire Arc" typeId="4.669726520417263e+35">Left</characteristic>
          </characteristics>
        </profile>
        <profile name="Hellfire Starboard Lance Battery" id="08c3-e4e1-54de-8226" hidden="false" typeId="41726d616d656e7423232344415441232323" typeName="Armament">
          <characteristics>
            <characteristic name="Range/Speed" typeId="52616e67652f537065656423232344415441232323">45cm</characteristic>
            <characteristic name="Firepower/Str" typeId="46697265706f7765722f53747223232344415441232323">2</characteristic>
            <characteristic name="Fire Arc" typeId="4.669726520417263e+35">Right</characteristic>
          </characteristics>
        </profile>
        <profile name="Overload Reactors" id="50f0-8e9c-ee94-78b4" hidden="false" typeId="5a49-6569-78e9-a35c" typeName="Special Rule">
          <characteristics>
            <characteristic name="Effects" typeId="fe13-6bab-c5cb-4f1d">When using the special order &apos;All Ahead Full&apos; or &apos;Burn Retros&apos; the ship may not use any of its lance batteries. This is because the ship needs to re&apos;channel the energy used to power these weapons back to the engines and thrusters.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Iconoclast Class Destroyer" id="9c37-be2b-9741-5b3f" collective="false" hidden="false" import="true" page="126" publicationId="11f0-17d1-e4d2-1018" type="upgrade">
      <categoryLinks>
        <categoryLink name="Escort" id="495e-bafe-005d-b01b" hidden="false" primary="true" targetId="4573636f72747323232344415441232323"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="points" value="30"/>
      </costs>
      <entryLinks>
        <entryLink name="Escort Astartes Crew" id="ebc2-6207-ddbb-27a8" collective="false" hidden="false" import="true" targetId="0772-b815-88ac-b722" type="selectionEntry"/>
      </entryLinks>
      <profiles>
