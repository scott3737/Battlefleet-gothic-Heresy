      <selectionEntries>
        <selectionEntry name="May take an additional shield" id="761d-8965-3d76-7581" defaultAmount="0" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ce6c-e49a-4851-7d17" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
