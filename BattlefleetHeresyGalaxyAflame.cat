      </modifiers>
      <selectionEntries>
        <selectionEntry name="Mark of Khorne" id="81a9-7ba5-feb0-1374" hidden="false" import="true" type="upgrade">
          <rules>
            <rule name="Mark of Khorne" id="200d-3aa6-0ca4-678b" hidden="false">
              <description>The marked vessel doubles its troop value in boarding actions.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Mark of Tzeentch" id="0ec5-d4ff-bfec-1857" hidden="false" import="true" type="upgrade">
          <rules>
            <rule name="Mark of Tzeentch" id="c4cb-04ff-b576-a511" hidden="false">
              <description>Once per turn the marked vessel may re-roll the result of any roll on the Critical Hits table it suff ers or infl icts on an enemy, including the results of hit-and-run raids. The second result stands, even if it is worse.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Mark of Slaanesh" id="71ff-9bf0-e88a-e6a3" hidden="false" import="true" type="upgrade">
          <rules>
            <rule name="Mark of Slaanesh" id="f49d-16f0-9a06-192c" hidden="false">
              <description>All enemy ships and squadrons within 15 cm of the marked vessel suff er a -1 Ld penalty. This is an area eff ect that is not aff ected by line of sight obstructions. Note that this eff ect is not cumulative with multiple marked ships.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Mark of Chaos Undivided" id="f78c-7ddf-d62a-0edf" hidden="false" import="true" type="upgrade">
          <rules>
            <rule name="Mark of Chaos Undivided" id="5b30-c634-930d-8a65" hidden="false">
              <description>Once per game, before a ship takes a leadership test or command check, you may have your entire fl eet use the marked vessel’s leadership value until the end of the turn.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Mark of Nurgle" id="97f9-697f-22d4-7d08" hidden="false" import="true" type="upgrade">
          <rules>
            <rule name="Mark of Nurgle" id="f49f-8ed4-5518-4876" hidden="false">
              <description>The marked vessel gains 1 additional Hit Point and a +1 bonus when defending against boarding actions.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
