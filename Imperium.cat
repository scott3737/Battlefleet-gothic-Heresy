      <rules>
        <rule name="Double Boarding Value" id="c64f-ac42-2df7-887b" hidden="false">
          <description>Double Boarding Value.
Scores 3 points in a planetary assault rather than 2.</description>
        </rule>
        <rule name="Terminator Teleport" id="7ec4-8120-be09-ba95" hidden="false">
          <description>Terminator Teleport Assault (roll 2D6 when conducting H&amp;R teleport attacks and select which one you wish to count).
(This is the Marshal/Master of the fleet, you can&apos;t have 2!).</description>
        </rule>
        <rule name="Sword Brethren" id="0817-0bf1-b535-e51d" hidden="false">
          <description>(Normal Space Marine Terminator boarding party AND +1 Boarding Modifier).</description>
        </rule>
        <rule name="Large Fuel Reserves" id="1872-4116-1a2b-1342" hidden="false">
          <description>Roll 4D6cm for the blast radius should the ship explode.</description>
        </rule>
      </rules>
